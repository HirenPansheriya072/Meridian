PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/meridian
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Confirmation and reminder emails. Leave SMTP_HOST blank to log to console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Meridian <no-reply@meridian.scheduling>"

DEMO_EMAIL=demo@meridian.scheduling
DEMO_PASSWORD=demo1234
